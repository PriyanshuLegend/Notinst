# Notinst (InstaFocus) — Environment Variables
# Create a .env.local file to configure your credentials.

# Public app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta / Instagram App Credentials (from https://developers.facebook.com)
# Create an App with "Instagram" / "Instagram Graph API" or "Instagram Login for Business"
INSTAGRAM_CLIENT_ID=your_instagram_app_id_here
INSTAGRAM_CLIENT_SECRET=your_instagram_app_secret_here

# Must match exactly the Valid OAuth Redirect URI registered in Meta Developer Portal:
# e.g., http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Scopes to request (comma-delimited)
# Current 2025/2026 standard for Instagram Professional Accounts:
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish

# Secret used to sign session cookies
SESSION_SECRET=change_this_to_a_random_32_char_secret_string
